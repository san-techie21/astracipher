{
  "name": "@astracipher/a2a-adapter",
  "version": "0.1.0",
  "description": "Google A2A (Agent-to-Agent) protocol adapter for AstraCipher — bridges A2A agent discovery, task management, and authentication with AstraCipher cryptographic identity",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astracipher/core": "^0.1.0",
    "@astracipher/crypto": "^0.1.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.2",
    "helmet": "^8.1.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "a2a",
    "agent-to-agent",
    "google-a2a",
    "astracipher",
    "agent-identity",
    "did",
    "verifiable-credentials",
    "ai-agents"
  ]
}
