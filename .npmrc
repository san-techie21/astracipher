# AstraCipher npm configuration
# The NPM_TOKEN is set via GitHub Actions secrets for CI/CD publishing
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Ensure workspace:* dependencies are resolved to actual versions during publish
save-exact=false

# Access level for scoped packages
access=public

# Suppress update notifier (prevents turbo from misinterpreting npm stderr)
update-notifier=false
