# AgentPass Server Configuration
NODE_ENV=development
PORT=3456
NETWORK=testnet

# Database
DATABASE_URL=postgresql://agentpass:agentpass@localhost:5432/agentpass

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT=100

# Logging
LOG_LEVEL=info

# Registry
REGISTRY_URL=https://testnet.registry.agentpass.dev

# Razorpay (India payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (international payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
