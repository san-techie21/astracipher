{
  "name": "astracipher",
  "version": "0.1.0",
  "private": true,
  "description": "AstraCipher Protocol — Cryptographic Identity & Trust for AI Agents (Open Source BSL-1.1)",
  "author": "Santosh <san.techie21@gmail.com>",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/AstraFintechLabs/astracipher.git"
  },
  "workspaces": [
    "packages/core",
    "packages/crypto",
    "packages/cli",
    "packages/compliance-core",
    "integrations/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.11.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["prettier --write", "eslint --fix"],
    "*.{json,md}": ["prettier --write"]
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "note": "Proprietary packages (server, dashboard, compliance modules) live in the separate private astracipher-platform repository."
}
